# cli-boot-kit profile: bazzite
# Target: Bazzite desktop (Fedora Atomic / rpm-ostree, KDE). Host-specific
# system config lives in the host's own repo (e.g. htpc), which vendors this kit
# and runs only the user-level modules:
#   homebrew.sh, brew-bundle.sh, chezmoi.sh, developer-tools.sh
# bootstrap.sh / verify.sh and the system modules do not support Fedora Atomic.

# chezmoi source repo passed to `chezmoi init <repo> --apply`.
CHEZMOI_REPO=l1ttleflyyy

# Developer CLIs (official installers into the user's home).
INSTALL_CLAUDE=yes
INSTALL_CODEX=yes
